{
  "name": "cmdkite",
  "description": "OpenCode-style desktop GUI for Command Code. Unofficial — not affiliated with Command Code or OpenCode.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "repository": {
    "type": "git",
